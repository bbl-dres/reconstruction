__pycache__/
*.pyc
.work/
node_modules/
dist/
*.blend1

# Original conversion intermediates: only catalog-referenced Meshopt assets ship.
/reconstructions/*/public/models/**/building.glb
/reconstructions/*/public/models/**/surroundings.glb
/reconstructions/*/public/models/**/building-[0-9a-f]*.glb
/reconstructions/*/public/models/**/surroundings-[0-9a-f]*.glb
# Each reconstruction's authoring workspace (references, research, stages, frozen
# versions, retired models) lives in work/ and is never published. It is tracked in
# a separate private repository instead (see docs/adding-a-building.md).
/reconstructions/*/work/

# This repository is published to GitHub Pages: everything committed is public.
# Local outputs, downloads and tools stay out; each reconstruction may add more
# rules or exceptions (von-wattenwyl-haus publishes its viewer/output/).
output/
venv/
.venv/

# Large or derived formats that are never published as-is: trained splats and
# point clouds, raw scans and source scenes, plain IFC (the .ifczip is the
# published form), Matterport meshes, archives and partial downloads.
*.ply
*.splat
*.spz
*.sog
*.ksplat
*.e57
*.las
*.laz
*.ifc
# Small, CC BY 4.0 teaching samples of the BIM modelling guide (sources and licences beside them).
!/docs/bim-modelling-guide/examples/**/*.ifc
*.blend
*.dam
*.zip
*.7z
*.tgz
*.tar.gz
*.part

# Operating system and editor clutter
.DS_Store
Thumbs.db
desktop.ini
